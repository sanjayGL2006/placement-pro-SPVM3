{
  "version": 2,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "backend/app.py"
    },
    {
      "src": "/assets/(.*)",
      "dest": "assets/$1"
    },
    {
      "src": "/frontend/assets/(.*)",
      "dest": "frontend/assets/$1"
    },
    {
      "src": "/$",
      "dest": "frontend/previews/dashboard.html"
    },
    {
      "src": "/(.*)",
      "dest": "frontend/previews/$1"
    }
  ]
}
